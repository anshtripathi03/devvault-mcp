{
  "name": "@devvault/mcp",
  "version": "0.1.0",
  "description": "Connect DevVault to a coding agent: research in, context out.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "devvault-mcp": "dist/bin/stdio.js"
  },
  "main": "dist/server.js",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "start": "node dist/bin/stdio.js",
    "start:http": "node dist/bin/http.js",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "express": "^4.21.2",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "typescript": "^5.7.2"
  }
}
